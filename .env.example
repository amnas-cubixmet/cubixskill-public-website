# CubixSkill Public Website (Next.js)
#
# Local development: npm run dev (port 5175), Django on port 8000.
# The /instructor-register form posts to same-origin /api/instructor-register,
# where a Next.js server route forwards to Django. No browser CORS needed.

# DEVELOPMENT: used by existing website features and as an optional server proxy
# fallback. NEVER leave a localhost API URL configured in Vercel production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# PRODUCTION REQUIRED: set to the real, publicly reachable HTTPS Django URL
# in Vercel Project Settings > Environment Variables. Server-only variable.
# Do not include /api/v1; no trailing slash or path.
# CUBIXSKILL_BACKEND_URL=https://your-deployed-django-api.example.com

# Set to your real instructor app login (not the public signup URL).
# NEXT_PUBLIC_INSTRUCTOR_LOGIN_URL=https://your-instructor-app.example.com/login
NEXT_PUBLIC_INSTRUCTOR_LOGIN_URL=http://localhost:5173/login
